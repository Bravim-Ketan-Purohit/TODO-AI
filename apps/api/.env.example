# OpenRouter (LLM)
OPENROUTER_API_KEY=
# optional override; defaults to nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=

# Google OAuth (Web application client; enable the Calendar API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# comma-separated allowlist; empty = anyone can sign in
ALLOWED_EMAILS=
